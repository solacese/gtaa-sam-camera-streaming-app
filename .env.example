# ── Solace PubSub+ Connection (VITE_ prefix required for client-side exposure) ──
VITE_SOLACE_URL=ws://localhost:8008
VITE_SOLACE_VPN=default
VITE_SOLACE_USERNAME=default
VITE_SOLACE_PASSWORD=default

# ── Camera Topics ───────────────────────────────────────────────────────────
# Root of the terminal camera topic space. Per-airline topics are derived as:
#   <root>/<airlineId>/feed     JPEG frames  (aircanada | westjet | porter)
#   <root>/<airlineId>/status   JSON gate/queue status
VITE_FEED_TOPIC_ROOT=gtaa/pearson/camera

# Topic the control panel announces the currently-active airline feed on.
VITE_CONTROL_TOPIC=gtaa/pearson/camera/control/active

# ── Terminal Capacity Analysis Topics ───────────────────────────────────────
# Control panel publishes a capacity-analysis request here...
VITE_ANALYSIS_TOPIC=gtaa/pearson/terminal/capacity/v1/analyze
# ...and renders the markdown result it receives back here.
VITE_ANALYSIS_RESULT_TOPIC=gtaa/pearson/terminal/capacity/v1/result

# ── Demo Mode ───────────────────────────────────────────────────────────────
# 'true' runs without a Solace broker: published frames loop back locally, the
# viewing rooms render a synthetic concourse feed, and capacity analysis returns
# a simulated result.
VITE_DEMO_MODE=false

# ── Session ID ──────────────────────────────────────────────────────────────
# Default 'true': a UUID is minted at startup and appended to every camera topic
# (feed, status and control). The landing page and control panel render a QR code
# per airline that deep-links a viewing room into this same session, so two camera
# stations on one broker never collide. Set 'false' for flat, shared topics.
VITE_SESSION_ID_ENABLED=true
